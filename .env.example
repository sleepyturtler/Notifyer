# Copy to .env and fill in. The bot reads real environment variables (it does not load this file by itself):
# run locally with `node --env-file=.env index.js`, or set the same variables in your host's dashboard.

# ── Required ──────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DATABASE_URL=postgres://user:pass@host:5432/dbname

# ── Strongly recommended ──────────────────────────────────────────────────
# Public https URL the bot is reachable at (OAuth callbacks, YouTube push). Falls back to RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=
# Your Discord user ID: gates owner-only commands and gets a DM if every Twitter mirror is down.
BOT_OWNER_ID=
# Port for the built-in HTTP server (most hosts set this for you).
PORT=3000

# ── Platforms: each switches on only when its credentials are set ─────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
YOUTUBE_API_KEY=
# Instagram/TikTok linking also needs PUBLIC_BASE_URL and your own approved developer apps.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────
# Comma-separated Nitter mirrors for Twitter/X (they must have RSS enabled).
# NITTER_INSTANCES=https://nitter.netbub.com,https://nitter.meowing.monster,https://nitter.kareem.one
# Let any server add RSS feeds (otherwise owner only).
# RSS_PUBLIC=true
# Poll bounds for the platforms that adapt to how often an account posts (milliseconds).
# TWITTER_POLL_DEFAULT_MS=300000
# TWITTER_POLL_MIN_MS=120000
# TWITTER_POLL_MAX_MS=1800000
# RSS_POLL_DEFAULT_MS=600000
# RSS_POLL_MIN_MS=120000
# RSS_POLL_MAX_MS=3600000
# YouTube backup poll while push notifications are confirmed (never below 2 minutes).
# YOUTUBE_POLL_INTERVAL_MS=1200000
# User-Agent for RSS feed requests (defaults to an identifiable Notifyer one).
# RSS_USER_AGENT=
# DATABASE_SSL_VERIFY=true
# WEBSUB_SECRET=
# ALLOW_BULK_ORPHAN_PURGE=true
# KEEP_ALIVE_URL=
# LEGAL_CONTACT_EMAIL=
# BOT_OWNER_DISCORD_TAG=
